# .env.example 文件

# OpenAI API Key (如果使用 OpenAI)
OPENAI_API_KEY=sk-proj-xxxxxxxxxxxxx-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Anthropic API Key (如果使用 Anthropic)
ANTHROPIC_API_KEY=sk-ant-proj-xxxxxxxxx-xxxxxxxxxxxxxxxxxxxxx

# LLM 配置
LLM_MODEL=gpt-4o
LLM_TEMPERATURE=0.7
LLM_MAX_TOKENS=4096

# 浏览器配置
BROWSER_HEADLESS=true
BROWSER_TIMEOUT=30
BROWSER_SLOW_MO=0
BROWSER_USER_AGENT=Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/116.0.13 (like Gecko) Chrome/100.0)
BROWSER_VIEWPORT_WIDTH=1280
BROWSER_VIEWPORT_HEIGHT=720

# LangChain 配置
LANGCHAIN_VERBOSE=false

# 服务器配置
HOST=0.0.0.0
PORT=8000
DEBUG=false

# 数据库配置
DATABASE_URL=sqlite:///./data/browsers.db

# 空间配置
SCREENSHOT_DIR=screenshots
DATA_DIR=data
LOG_DIR=logs

# Docker 配置（可选）
# COMPOSE_PROJECT=browser-automation
# SERVICE_PORTS=8000:8000

# 背景颜色
BACKGROUND_COLOR=#f0f0f2
SECONDARY_COLOR=#1f1f1f1
TERTIARY_COLOR=#f9fafb
ACCENT_COLOR=#e1f5ff
SUCCESS_COLOR="#d1f5d3"
WARNING_COLOR="#ff9f50"
ERROR_COLOR="#f44336"
INFO_COLOR="#57c14a"
TEXT_COLOR="#000000"
CODE_BACKGROUND=#1e1e1e
TEXT_BACKGROUND_SECONDARY=#2e1e1e"
    CODE_BACKGROUND_SECONDARY=#000000

# 状态颜色
STATUS_PENDING=orange
STATUS_IN_PROGRESS=blue
STATUS_COMPLETED=green
STATUS_FAILED=red
STATUS_CANCELLED=gray

# 主题颜色
PRIMARY="#4e7ae"
SECONDARY="#6c757d"
TERTIARY="#000000"
TEXT="#e1e1e1e1e1"
BACKGROUND="#ffffff"
SECONDARY_TEXT="#ffffff"
ACCENT="#ffffff"
BORDER_COLOR="#e1f5ff"
HOVER="#e1f5ff"
INPUT_BACKGROUND="#ffffff"
INPUT_BORDER="#ccc"

# 布局
FONT_FAMILY=sans-serif
BORDER_RADIUS=4px
BOX_SHADOW=none
INPUT_BORDER_COLOR=#ccc
FOCUS_BORDER_COLOR="#4e7ae
FOCUS_BORDER_WIDTH=2px
BORDER_RADIUS=4px
TEMPORARY_BORDER_COLOR=gray
FONT_WEIGHT=400

# 侧边栏宽度
SIDEBAR_WIDTH=280

### 必填项
FORCE_HIGH_DARK_THEME=true
"""在 Light 模式下强制使用深色主题"""
SHOW_PAGE_NAVIGATION_BAR=true
"""显示页面顶部导航栏（Light 模式）"""
"""在 Light 模式下使用灰度边框"""
USE_PAGES_CONTAINER=false"""使用容器包裹内容，但默认不包裹侧边栏"""

### 提示词
SHOW_HOME_PAGE_HINT=true
SHOW_HOME_PAGE_ICON=false
HEADER_PADDING="sidebar"
SHOW_PAGE_ICON=false
HEADER_PADDING="sidebar"

### 其他
USE_CACHE_DEFAULTS=true
USE_COLLAPSE_SIDEBAR_ITEMS=false
USE_COLLAPSE_CONTENT=true
USE_COLLAPSE_SIDEBAR_ITEMS=false
SHOW_LOGOUT=true
USE_COLLAPSE_CONTENT=true

### 模型
SHOW_API_KEY_IN_SIDEBAR=false
SHOW_SIDEBAR_API_KEY_IN_SIDEBAR=false
SHOW_API_KEY_IN_MODEL_SELECT=false
SHOW_API_KEY_IN_MODEL_SELECT_MODE=chat_model"
SHOW_ONLY_MODELS=true
    "model": "gpt-4o",
    "modelDisplayName": "GPT-4o",
    "models": []
}
